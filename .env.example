# Database
# Use a pooled PostgreSQL connection string in serverless production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-character-secret"
AUTH_SECRET="replace-with-the-same-random-secret"

# Optional Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Site branding
SITE_NAME="Salt Route"
SITE_BRAND_NAME="Salt Route Group"
SITE_TAGLINE="Tailored Stays & Consulting · Nepal"
SITE_REGION="Nepal"
SITE_URL="http://localhost:3000"

# Contact details
INFO_EMAIL="info@example.com"
ADMIN_EMAIL="admin@example.com"
ENQUIRIES_EMAIL="enquiries@example.com"
SUPPORT_EMAIL="support@example.com"
CONTACT_PHONE="+977 9700013336"
CONTACT_PHONE_HREF="tel:+9779700013336"
CONTACT_ADDRESS="Chabahil, Kathmandu, Nepal"
CONTACT_ADDRESS_FULL="Salt Route Group HQ, Chabahil, Kathmandu, Nepal"
CONTACT_MAP_URL="https://maps.google.com/?q=Chabahil,Kathmandu,Nepal"

# Public social profiles (leave empty to hide)
SOCIAL_INSTAGRAM=""
SOCIAL_FACEBOOK=""
SOCIAL_WHATSAPP="https://wa.me/9770000000000"

# Regional formatting
CURRENCY_CODE="NPR"
CURRENCY_SYMBOL="NPR"
CURRENCY_LOCALE="en-NP"

# Email delivery (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user@example.com"
SMTP_PASSWORD="replace-with-an-app-password"
SMTP_FROM="Salt Route <noreply@example.com>"

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Optional background jobs (Redis)
REDIS_URL=""

# WhatsApp concierge
# Use digits only; do not include a leading + sign or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER="9770000000000"

# Optional copy overrides; {code} is replaced with the booking reference.
EMAIL_SUBJECT_BOOKING_RECEIVED="Booking Request Received: {code}"
EMAIL_SUBJECT_INQUIRY_RECEIVED="We Received Your Enquiry: Salt Route"

# Operational settings
CRON_SECRET="replace-with-a-random-cron-secret"
RATE_LIMIT_BOOKINGS_PER_HOUR="10"
RATE_LIMIT_INQUIRIES_PER_HOUR="15"
RATE_LIMIT_REVIEWS_PER_DAY="3"
DEFAULT_PAGE_SIZE="25"
ANALYTICS_CACHE_TTL="300"

# Optional AI features (Groq primary, OpenRouter fallback)
GROQ_API_KEY=""
GROQ_MODEL="groq/compound-mini"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
AUTH_TRUST_HOST="true"
